EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where the admin portal lives, e.g. https://midrive-v2.vercel.app
#
# Used for the two things a phone cannot do on its own:
#
#   * after a driver submits a vehicle check, asking the portal to analyse it
#     straight away rather than waiting for the scheduled run;
#   * reading a licence or passport photo, which needs a vision model, whose
#     API key must never ship inside an app bundle.
#
# Entirely optional either way. Leave it empty and vehicle checks still work end
# to end, and onboarding still works -- drivers type their document details in
# by hand, which is what they do anyway whenever a photo cannot be read.
#
# The portal drains the check queue every few minutes, which is what makes that
# feature reliable when a driver submits and immediately locks their phone.
EXPO_PUBLIC_PORTAL_URL=
