EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where the admin portal lives, e.g. https://midrive-v2.vercel.app
#
# Used for exactly one thing: after a driver submits a vehicle check, the app
# asks the portal to analyse it straight away rather than waiting for the
# scheduled run to pick it up.
#
# Entirely optional. Leave it empty and vehicle checks still work end to end --
# the portal drains the queue every few minutes, which is what makes the feature
# reliable when a driver submits and immediately locks their phone. This only
# shortens the wait on the processing screen.
EXPO_PUBLIC_PORTAL_URL=
